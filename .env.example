# ==========================================
# SENTRAX PLATFORM CONFIGURATION
# Gujarat Sentinel Hybrid CCTV Intelligence
# ==========================================

# Environment Mode: development | production | testing
ENVIRONMENT=development
PROJECT_NAME="SENTRAX CCTV Intelligence Platform"

# Security & JWT
# Generate a strong key in production: openssl rand -hex 32
SECRET_KEY=sentrax_super_secret_production_key_change_in_real_deploy_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Default Root / Initial Admin Credentials
INITIAL_ADMIN_EMAIL=command@sentrax.gujarat.gov.in
INITIAL_ADMIN_PASSWORD=SentinelAdmin2026!
INITIAL_ADMIN_BADGE=GJ-HQ-001
INITIAL_ADMIN_NAME="State Command Center"

# Database Configuration (PostgreSQL + PostGIS)
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=sentrax_admin
POSTGRES_PASSWORD=sentrax_secure_postgis_password_2026
POSTGRES_DB=sentrax_db

# File Storage Paths
DATA_DIR=/app/data
VIDEOS_DIR=/app/data/videos
EVIDENCE_DIR=/app/data/evidence

# CORS & Gateway
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:80","http://localhost"]
